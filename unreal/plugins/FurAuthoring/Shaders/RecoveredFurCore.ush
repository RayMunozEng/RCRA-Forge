// PS_FurShellGBufferDeferred material terms, before G-buffer quantization.
float3 furGroom(float2 control, float scaledHandedness) {
    float2 comb = (control * 2.0 - 1.0) * abs(scaledHandedness);
    float combZ = sqrt(1.0 - min(dot(comb, comb), 0.99));
    return normalize(float3(comb, combZ));
}

float2 furLayerUV(float2 uv, float density, float3 groom, float curvedOffset,
                float uvDivisor) {
    // Preserve multiply-then-divide before adding the base UV. Reassociation
    // crosses a native texture-filter boundary in the captured head draw.
    precise float2 offset = groom.xy * curvedOffset;
    precise float2 shift = offset / groom.z;

    return (density * uv + shift) / uvDivisor;
}

float furWetLayerValue(float sampledValue, float wetness) {
    float expanded = exp2(log2(clamp(sampledValue + 0.1, 0.0, 1.0)) * 5.0);
    precise float difference = expanded - sampledValue;
    return mad(difference, wetness, sampledValue);

}

float4 furWetAlbedo(float4 albedo, float wetness, float shellDepth) {
    float wetBlend = sqrt(shellDepth) * wetness;
    // The native multiplier is the float immediately above -0.2.
    precise float4 attenuation = albedo * asfloat(0xbe4cccccu);
    return mad(attenuation, wetBlend.xxxx, albedo);

}

float2 furMotionVector(float2 pixel, float2 inverseViewport, float4 previousClip,
                     float nearPlane, float2 viewportSize) {
    float inversePrevious = 1.0 / max(previousClip.w, nearPlane);
    precise float2 currentUV = pixel * inverseViewport;
    precise float2 currentCentered = currentUV - 0.5;
    precise float2 previousHalf = previousClip.xy * 0.5;
    precise float2 motion = mad(float2(-1.0, 1.0) * previousHalf,
                             inversePrevious.xx, currentCentered);

    return motion * viewportSize;
}

float3 furStrandDirection(float3 normal, float4 worldTangent, float3 groom,
                       bool flipTangent) {
    float3 tangent = normalize(worldTangent.xyz);
    float handedness = worldTangent.w < 0.0 ? -1.0 : 1.0;
    if (flipTangent) handedness = -handedness;
    // Keep the cross-product magnitude. The captured frame is not
    // orthogonalized after bending and raster interpolation.
    float3 bitangent = cross(normal, tangent) * handedness;
    return normalize(-tangent * groom.x + bitangent * groom.y + normal * groom.z);
}

float furContactDepth(float viewDepth, float controlLength,
                      float layerValue, float phase, float shellDepth,
                      float furLength) {
    float fieldOffset = (0.25 - phase * 0.125) - layerValue * 0.125;
    precise float offset = (0.95 * controlLength + 0.05)
        * (1.0 - shellDepth) * fieldOffset;
    return mad(-offset, furLength + 0.005, viewDepth);

}

float2 furGlossSpecular(float2 sampledResponse, float glossScale,
                     float specularScale, float wetness, float shellDepth) {
    float gloss = clamp(sqrt(max(sampledResponse.r, 0.0)) * glossScale, 0.0, 1.0);
    float wetBlend = sqrt(shellDepth) * clamp(wetness, 0.0, 1.0);
    gloss += (1.0 - gloss) * wetBlend;
    float specular = sqrt(clamp(sampledResponse.g * specularScale, 0.0, 1.0));
    return float2(gloss, specular);
}

float hairScreenHash(float2 normalizedPixel, float temporalIndex) {
    return frac(sin(dot(normalizedPixel, float2(
        asfloat(0x414fd639u), asfloat(0x429c774cu)
    ))) * asfloat(0x472aee8cu) + temporalIndex);
}

// Fur PS uses pixel centers; Hair/HairDenoise compute use integer coordinates.
// DXIL unary opcode 27 is Round_ni (floor), including negative shell offsets.
float hairScreenPhase(float2 pixel, float2 inverseDimensions,
                      float temporalIndex, float temporalPlusCycle) {
    float2 cell = floor(pixel);
    float base = cell.x + cell.y * 2.0 + temporalPlusCycle;
    precise float seed = base + hairScreenHash(pixel * inverseDimensions, temporalIndex);

    return frac(seed * asfloat(0x3e4ccccdu));
}

float hairCoveragePhase(float2 pixel, float slice, float2 inverseDimensions,
                        float temporalIndex, float temporalPlusCycle) {
    // Native D3D12 fuses x - 10*slice. The one-ULP difference in this
    // coordinate changes the amplified sine hash at fractional shell slices.
    float2 shifted = float2(mad(-10.0, slice, pixel.x), pixel.y + slice);

    return hairScreenPhase(shifted, inverseDimensions, temporalIndex, temporalPlusCycle);
}

float hairWetnessStep(float wetness, float phase) {
    float remaining = 1.0 - clamp(wetness, 0.0, 1.0);
    float wetBase = (1.0 - remaining * remaining) * 8.0;
    return clamp(floor((phase * 0.1 + 0.45) + wetBase) * 0.125, 0.0, 1.0);
}

// CS_ApplyGBufferLighting_Hair DXIL: integer pixel coordinates in D3D order.
// Keep the base and jitter addition before the 0.2 scale. Distributing that
// scale changes shadow/reflection sample positions at float32 precision.
float3 hairLightingNoise(
        float2 pixel, float2 inverseDimensions,
        float temporalIndex, float temporalPlusCycle) {
    float phaseScale = asfloat(0x3e4ccccdu);
    float angleScale = asfloat(0x4196cbe4u);
    float base = pixel.x + pixel.y * 2.0 + temporalPlusCycle;
    float checker = frac((pixel.x + pixel.y + temporalIndex) * 0.5 + 0.25);
    precise float directSeed = base + checker;

    float2 normalizedPixel = pixel * inverseDimensions;
    float hash = hairScreenHash(normalizedPixel, temporalIndex);
    precise float reflectionSeed = base + hash;

    float contactPhase = frac(base * phaseScale)
        + float((int(pixel.x) + int(pixel.y) + int(temporalIndex)) & 1)
            * asfloat(0x3dcccccdu);
    return float3(frac(directSeed * phaseScale) * angleScale,
                frac(reflectionSeed * phaseScale) * angleScale,
                contactPhase);
}

