float3 retailWindOffset(float2 uv, float3 localWind, float windTime, float turbulence, float objectPhase, float radius, float strength) {
    float lowFrequency = turbulence * 20.0 + 10.0;
    float highFrequency = turbulence * 100.0 + 50.0;
    float spatial = sin(lowFrequency * uv.x) + sin(lowFrequency * uv.y)
        + 0.5 * (sin(highFrequency * uv.x) + sin(highFrequency * uv.y));
    float envelope = objectPhase * 0.9 + 0.05 + spatial * 0.05;
    float denominator = 1.925 - envelope * 0.875;
    float ramp = denominator <= 0.0 ? 0.0 : clamp(
        (0.6625 - envelope * 0.4375) / denominator, 0.0, 1.0
    );
    float smoothRamp = ramp * ramp * (3.0 - 2.0 * ramp);
    float wave = (
        (1.0 - smoothRamp) * envelope + smoothRamp + 1.0
    ) * sin((envelope + frac(windTime * 0.15915493667125702))
            * 6.2831854820251465) - 1.0;
    float directionalCap = min(
        smoothRamp * (envelope * 0.0125 + 0.0375),
        radius * 0.1
    );

    float speed = turbulence * 10.0 + 5.0;
    float noiseTime = (windTime + 0.125 + spatial * 0.125) * speed;
    float f = frac(noiseTime);
    float f2 = f * f;
    float f3 = f2 * f;
    float4 weights = float4(
        -f + 2.0 * f2 - f3,
        1.0 - 2.0 * f2 + f3,
        f + f2 - f3,
        -f2 + f3
    );
    int tableIndex = int(frac(noiseTime * 0.016393441706895828) * 61.0);
    float3 randomVector = RETAIL_WIND_RANDOM[tableIndex].xyz * weights.x
        + RETAIL_WIND_RANDOM[tableIndex + 1].xyz * weights.y
        + RETAIL_WIND_RANDOM[tableIndex + 2].xyz * weights.z
        + RETAIL_WIND_RANDOM[tableIndex + 3].xyz * weights.w;
    float3 baseWind = float3(wave, -1.0, wave) * strength
        + localWind * directionalCap;
    return (randomVector * strength + baseWind) * (1.0 / 30.0);
}

