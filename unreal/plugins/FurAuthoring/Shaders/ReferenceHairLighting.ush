// Generated by export_reference_lighting.py. Recovered direct and authored-cube response.
#ifndef RF_REFERENCE_LIGHTING
#define RF_REFERENCE_LIGHTING
// Native PS_FurShellGBufferDeferred packing. Specular is the square-root
// encoded response; gloss is linearTerm. Output channels are RGBA16_UINT.
uint4 furPackGBuffer(float3 normal, float gloss, float specular, uint renderFlags) {
    float scale = rsqrt(abs(normal.z) * 8.0 + 8.0);
    uint2 xy = ((uint2)(normal.xy * 5791.20458984375 * scale + 2048.0));
    uint flags = ((renderFlags << 6u) & 4096u)
        | ((renderFlags >> 13u) & 16384u) | 8192u;
    if (normal.z < 0.0) flags |= 32768u;
    flags ^= 4096u;
    uint specularByte = uint(clamp(specular, 0.0, 1.0) * 255.0 + 0.5);
    uint glossByte = uint(clamp(gloss, 0.0, 1.0) * 255.0 + 0.5);
    return uint4(xy.x | 24576u, xy.y | flags,
                 (specularByte << 8u) | specularByte,
                 (specularByte << 8u) | glossByte);
}

uint furPackExtra(float3 strand, float transmittance) {
    float scale = rsqrt(abs(strand.z) * 8.0 + 8.0);
    uint2 xy = ((uint2)(strand.xy * 722.6631469726562 * scale + 256.0));
    uint transmission = uint(clamp(transmittance * 0.5, 0.0, 1.0) * 127.0 + 0.5);
    return xy.x | (xy.y << 9u) | (uint(strand.z < 0.0) << 18u)
        | (transmission << 19u);
}

float3 furUnpackNormal(uint4 encoded) {
    float2 codes = ((float2)(encoded.xy & ((uint2)(4095u))));
    float2 xy = mad(codes, ((float2)(asfloat(0x3a351044u))),
                  ((float2)(asfloat(0xbfb504f3u))));

    float radiusSquared = dot(xy, xy);
    float z = 1.0 - radiusSquared * 0.5;
    return float3(xy * sqrt(1.0 - radiusSquared * 0.25),
                (encoded.y & 32768u) != 0u ? -z : z);
}

float3 furUnpackStrand(uint encoded) {
    float2 codes = float2(encoded & 511u, (encoded >> 9u) & 511u);
    float2 xy = mad(codes, ((float2)(asfloat(0x3bb55fa3u))),
                  ((float2)(asfloat(0xbfb504f3u))));

    float radiusSquared = dot(xy, xy);
    float z = 1.0 - radiusSquared * 0.5;
    return float3(xy * sqrt(1.0 - radiusSquared * 0.25),
                (encoded & 262144u) != 0u ? -z : z);
}

// View-oriented Hair frames, measured against native DXIL intermediates.
// The geometric normal and strand inputs are decoded G-buffer vectors.
float3 hairFrameCross(float3 a, float3 b) {
    precise float3 value = mad(-a.zxy, b.yzx, a.yzx * b.zxy);
    return value;

}

struct HairLobeFrame {
    float3 normal;
    float3 side;
};

HairLobeFrame hairLobeFrame(float3 strand, float3 normal, float3 viewDirection) {
    float strandNormal = dot(strand, normal);
    float3 perpendicular = hairFrameCross(strand, normal);
    float sine = sqrt(dot(perpendicular.yzx, perpendicular.yzx));
    precise float3 seed = mad(viewDirection, ((float3)(sine)), normal * strandNormal);

    HairLobeFrame frame;
    float3 side = hairFrameCross(seed, strand);
    frame.side = side * rsqrt(dot(side, side));
    float3 front = hairFrameCross(strand, frame.side);
    frame.normal = front * rsqrt(dot(front, front));
    return frame;
}

float3 hairSecondaryStrand(float3 strand, float3 normal, uint shiftCode) {
    float shift = mad(float(shiftCode), asfloat(0x3b1c09c2u), 0.075);
    precise float3 tangent = mad(((float3)(shift)), -normal - strand, strand);

    return tangent * rsqrt(dot(tangent, tangent));
}

// Hair direct-light lobes. GLSL 4.30+, or GL_ARB_gpu_shader5 in GLSL 3.30.
// The normal/light/view dots refer to the view-oriented strand frame.
float hairLobeNormalizationSquared(float square) {
    // Reuse the rounded square. Fusing 1-alpha*alpha changes a captured
    // R11G11B10 boundary; cancellation to a constant also loses retail behavior.
    precise float remainder = clamp(1.0 - square, 0.0, 1.0);
    precise float denominator = max(1.0 - remainder, 0.000001);

    return square / denominator;
}

float hairLobeDistribution(float3 halfDots, float2 alpha,
                           float normalLight, float normalView) {
    float tangentTerm = halfDots.y * halfDots.y / (alpha.x * alpha.x);
    float sideTerm = halfDots.z * halfDots.z / (alpha.y * alpha.y);
    precise float ellipsoid = mad(halfDots.x, halfDots.x, tangentTerm) + sideTerm;
    precise float average = mad(min(alpha.x, alpha.y), 0.75,
                                max(alpha.x, alpha.y) * 0.25);
    precise float masking = mad(average, asfloat(0x3eb504f0u),
                                asfloat(0x3eb504f0u));
    precise float maskingSquare = masking * masking;
    precise float remainder = mad(-masking, masking, 1.0);
    precise float lightMask = mad(normalLight, remainder, maskingSquare);
    precise float viewMask = mad(normalView, remainder, maskingSquare);
    precise float denominator = (alpha.x * alpha.y) * (ellipsoid * ellipsoid);
    denominator = (denominator * viewMask) * lightMask;
    precise float square = average * average;
    precise float response = (0.25 / max(denominator, 0.00001)) * normalLight;

    return response * hairLobeNormalizationSquared(square);
}

float3 hairFresnelFromFactor(float3 f0, float factor) {
    precise float3 sum = f0 + factor;
    precise float3 fresnel = mad(((float3)(-factor)), f0, sum);
    return fresnel;

}

float3 hairFresnel(float3 f0, float viewHalf) {
    float grazing = 1.0 - viewHalf;
    float square = grazing * grazing;
    return hairFresnelFromFactor(f0, (square * square) * grazing);
}

// Native Hair material response and final lighting resolve. GLSL 4.30+, or
// GL_ARB_gpu_shader5 in GLSL 3.30. Inputs are stored, decoded G-buffer values.
struct HairMaterialResponse {
    float3 primaryF0;
    float3 secondaryF0;
    float adjustedGloss;
    float2 gloss;
    float2 primaryAlpha;
    float2 secondaryAlpha;
    float2 primarySquared;
    float2 secondarySquared;
    float occlusion;
    float emissive;
    float transmission;
};

HairMaterialResponse hairMaterialResponse(uint4 material, uint strand,
                                         float4 albedo, float depth) {
    HairMaterialResponse response;
    float3 codes = float3(material.z >> 8u, material.z & 255u, material.w >> 8u);
    float3 specular = codes * asfloat(0x3b808081u);
    response.primaryF0 = specular * specular;
    response.secondaryF0 = clamp(sqrt(response.primaryF0) * 5.0, 0.0, 1.0)
        / (sqrt(albedo.rgb) + 0.75);
    bool hasOcclusion = (material.y & 8192u) != 0u;
    response.occlusion = hasOcclusion ? albedo.a : 1.0;
    response.emissive = hasOcclusion ? 0.0 : exp2(albedo.a * 5.0) - 1.0;
    response.transmission = float((strand >> 19u) & 127u) * asfloat(0x3c810204u);
    float gloss = float(material.w & 255u) * asfloat(0x3b808081u);
    precise float fade = clamp(mad(depth, 0.125, -0.25), 0.0, 1.0);
    precise float scale = mad(-fade, asfloat(0x3eaa7efau), 1.0);
    precise float adjusted = gloss * scale;
    precise float primary = mad(adjusted, 0.6, 0.1);
    precise float secondaryScale = mad(adjusted, 0.3, 0.05);
    precise float secondary = mad(-secondaryScale, primary, primary);
    // DXIL folds the primary gloss transform into these coefficients.
    precise float2 primaryWidth = clamp(mad(((float2)(-adjusted)),
        float2(asfloat(0x3ee6d481u), asfloat(0x3d38aa00u)),
        float2(asfloat(0x3f65b963u), asfloat(0x3f770953u))), 0.0, 1.0);
    precise float2 secondaryWidth = clamp(mad(((float2)(-secondary)),
        float2(asfloat(0x3f405bc0u), asfloat(0x3d99e300u)),
        ((float2)(asfloat(0x3f78f5c3u)))), 0.0, 1.0);

    response.adjustedGloss = adjusted;
    response.gloss = float2(primary, secondary);
    float2 primarySquare = primaryWidth * primaryWidth;
    float2 secondarySquare = secondaryWidth * secondaryWidth;
    response.primaryAlpha = primarySquare * primarySquare;
    response.secondaryAlpha = secondarySquare * secondarySquare;
    response.primarySquared = primarySquare;
    response.secondarySquared = secondarySquare;
    return response;
}

float3 hairWrappedLight(float3 normal, float3 light) {
    precise float3 wrapped = mad(normal - light, ((float3)(0.25)), light);
    return wrapped;

}

float hairDiffuseResponse(float normalLight, float transmission) {
    float width = transmission + 1.0;
    return clamp((normalLight + transmission) / (width * width), 0.0, 1.0);
}

float hairTransmissionResponse(float phase, float normalLight, float normalView) {
    precise float linearTerm = mad(-phase, 10.5, 8.0);
    precise float angular = mad(phase * phase, asfloat(0x404af3f5u), linearTerm);

    float attenuation = clamp(clamp(normalLight, 0.0, 1.0) * normalView, 0.0, 1.0) + 0.1;
    return 1.0 / (angular * attenuation);
}

// Diffuse transmission blend, specular history blend, specular occlusion.
float3 hairResolveWeights(float transmission, float normalView,
                        float materialOcclusion, float historyOcclusion) {
    precise float grazing = clamp(mad(-normalView, 2.0, 1.0), 0.0, 1.0);
    precise float square = grazing * grazing;
    precise float diffuse = mad(historyOcclusion * 0.5, square, 0.5) * transmission;
    precise float specular = mad(square, asfloat(0x3f75c28fu),
                                 asfloat(0x3d23d70au)) * transmission;

    float occlusion = min(materialOcclusion * materialOcclusion,
                          historyOcclusion * historyOcclusion);
    return float3(diffuse, specular, occlusion);
}

float3 hairResolveLighting(float3 albedo, float materialOcclusion, float emissive,
                         float3 weights, float3 diffuse, float3 back,
                         float3 specular, float3 history) {
    precise float3 mixedDiffuse = mad(((float3)(weights.x)), back - diffuse, diffuse);
    precise float3 mixedSpecular = mad(((float3)(weights.y)), history - specular, specular);
    precise float3 shadedDiffuse = mad(mixedDiffuse, ((float3)(materialOcclusion)), ((float3)(emissive)));
    precise float3 color = mad(albedo, shadedDiffuse, mixedSpecular * weights.z);

    return color;
}

// Native anisotropic environment sample frame. Include hair_frame.glsl first.
struct HairEnvironmentFrame {
    float3 normal;
    float3 reflection;
    float blend;
    float averageGloss;
};

HairEnvironmentFrame hairEnvironmentFrame(float3 normal, float3 strand, float3 view,
        HairLobeFrame primaryFrame, float2 primaryAlpha, float2 gloss, float angle) {
    HairEnvironmentFrame frame;
    float3 axis = primaryAlpha.x >= primaryAlpha.y ? primaryFrame.side : strand;
    float3 perpendicular = hairFrameCross(axis, view);
    float3 positive = perpendicular.yzx * axis.zxy;
    float3 negative = perpendicular.zxy * axis.yzx;
    float3 difference = (-normal - negative) + positive;
    float blend = clamp(((1.0 - dot(normal, strand)) * 1.5)
                         * max(primaryAlpha.x, primaryAlpha.y), 0.0, 1.0);
    float sine = sin(angle), cosine = cos(angle);
    float sineCube = (sine * sine) * sine;
    float cosineCube = (cosine * cosine) * cosine;
    float sumGloss = gloss.x + gloss.y;
    precise float3 base = mad(((float3)(blend)), difference, normal);
    precise float3 target = mad(primaryAlpha.x * strand, ((float3)(sineCube)), primaryFrame.normal);
    target = mad(primaryAlpha.y * primaryFrame.side, ((float3)(cosineCube)), target);
    precise float weight = mad(sumGloss, 0.25, 0.5);
    precise float3 direction = mad(base - target, ((float3)(weight)), target);

    frame.normal = direction * rsqrt(dot(direction, direction));
    float twiceView = dot(frame.normal, view) * 2.0;
    precise float3 reflection = mad(frame.normal, ((float3)(twiceView)), -view);
    frame.reflection = reflection;

    frame.blend = blend;
    frame.averageGloss = sumGloss * 0.5;
    return frame;
}

float RFDirectDistribution(HairLobeFrame frame, float3 strand, float3 light,
                          float3 view, float3 halfVector, float2 alpha)
{
    return hairLobeDistribution(float3(dot(frame.normal,halfVector),dot(strand,halfVector),dot(frame.side,halfVector)),
        alpha,saturate(dot(frame.normal,light)),min(abs(dot(frame.normal,view))+0.00001,1.0));
}
float3 RFSceneDirect(float3 normal, float3 strand, float3 view, float3 light,
                        float4 albedoOcclusion, float2 glossSpecular, float viewDepthM, float transmittance)
{
    uint4 packed=furPackGBuffer(normal,glossSpecular.x,glossSpecular.y,0u);
    uint extra=furPackExtra(strand,transmittance);
    normal=furUnpackNormal(packed);
    strand=furUnpackStrand(extra);
    HairMaterialResponse material=hairMaterialResponse(packed,extra,albedoOcclusion,viewDepthM);
    float3 secondaryStrand=hairSecondaryStrand(strand,normal,extra>>26u);
    HairLobeFrame primary=hairLobeFrame(strand,normal,view);
    HairLobeFrame secondary=hairLobeFrame(secondaryStrand,normal,view);
    float3 halfVector=normalize(light+view);
    float primaryDistribution=RFDirectDistribution(primary,strand,light,view,halfVector,material.primaryAlpha);
    float secondaryDistribution=RFDirectDistribution(secondary,secondaryStrand,light,view,halfVector,material.secondaryAlpha);
    float3 primarySpecular=hairFresnel(material.primaryF0,dot(view,halfVector))*primaryDistribution;
    float3 secondarySpecular=hairFresnel(material.secondaryF0,dot(view,halfVector))*secondaryDistribution;
    float normalLight=dot(normal,light),normalView=dot(normal,view);
    float diffuse=hairDiffuseResponse(normalLight,material.transmission);
    float back=hairTransmissionResponse(dot(-view,hairWrappedLight(normal,light)),normalLight,normalView);
    float3 weights=hairResolveWeights(material.transmission,normalView,material.occlusion,1.0);
    return hairResolveLighting(albedoOcclusion.rgb,material.occlusion,0.0,weights,
                              diffuse+secondarySpecular,back.xxx,primarySpecular,float3(0,0,0));
}
// Optional scene fill/rim contributions use the same recovered response as key.
// A zero radiance returns before normalization/lobe evaluation, preserving old
// single-light behavior and avoiding invalid vectors for disconnected lights.
float3 RFSceneAdditionalDirect(float3 normal,float3 strand,float3 view,
    float3 direction,float3 radiance,float4 albedoOcclusion,float2 glossSpecular,
    float viewDepthM,float transmittance)
{
    if (!any(radiance > 0) || dot(direction,direction) < 1e-8)
        return float3(0,0,0);
    return RFSceneDirect(normal,strand,view,normalize(direction),albedoOcclusion,
        glossSpecular,viewDepthM,transmittance)*max(radiance,0);
}
// Authored prefiltered cube bridge. Cube directions use UE axes by default;
// recoveredAxes=1 is for private Forge-oriented cube comparisons.
float3 RFSceneEnvironment(TextureCube cube,SamplerState cubeSampler,
    Texture2D brdf,SamplerState brdfSampler,float3 normal,float3 strand,float3 view,
    float4 albedoOcclusion,float2 glossSpecular,float viewDepthM,float transmittance,
    float angle,float intensity,float maxMip,float recoveredAxes)
{
    if(intensity<=0) return float3(0,0,0);
    uint4 packed=furPackGBuffer(normal,glossSpecular.x,glossSpecular.y,0u);
    uint extra=furPackExtra(strand,transmittance);
    normal=furUnpackNormal(packed);strand=furUnpackStrand(extra);
    HairMaterialResponse material=hairMaterialResponse(packed,extra,albedoOcclusion,viewDepthM);
    HairLobeFrame primary=hairLobeFrame(strand,normal,view);
    HairEnvironmentFrame env=hairEnvironmentFrame(normal,strand,view,primary,
        material.primaryAlpha,material.gloss,angle);
    float3 reflection=recoveredAxes>.5 ? env.reflection : env.reflection.xzy;
    float3 diffuseDirection=recoveredAxes>.5 ? normal : normal.xzy;
    float3 specularLight=cube.SampleLevel(cubeSampler,reflection,
        max(maxMip,0)*(1-saturate(env.averageGloss))).rgb*intensity;
    float3 diffuseLight=cube.SampleLevel(cubeSampler,diffuseDirection,max(maxMip,0)).rgb*intensity;
    float2 lookup=brdf.SampleLevel(brdfSampler,
        float2(saturate(abs(dot(env.normal,view))),saturate(env.averageGloss)),0).rg;
    float3 indirectSpecular=specularLight*(material.primaryF0*lookup.x+lookup.y);
    float3 indirectDiffuse=diffuseLight+specularLight*material.secondaryF0;
    float3 weights=hairResolveWeights(material.transmission,dot(normal,view),material.occlusion,1);
    return hairResolveLighting(albedoOcclusion.rgb,material.occlusion,0,weights,
        indirectDiffuse,float3(0,0,0),indirectSpecular,float3(0,0,0));
}
float3 RFReferenceDirect(float3 normal,float3 strand,float3 view,float3 light,
    float4 albedoOcclusion,float2 glossSpecular,float viewDepthM)
{
    return RFSceneDirect(normal,strand,view,light,albedoOcclusion,glossSpecular,viewDepthM,.1);
}
#endif
